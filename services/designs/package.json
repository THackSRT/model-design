{
  "name": "@atelier/designs",
  "version": "0.1.0",
  "private": true,
  "description": "Service designs : modèles, versions de modèle et spécifications de patron (service de référence).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "node --watch --env-file-if-exists=.env dist/main.js",
    "start": "node dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "nx": {
    "targets": {
      "test:integration": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    },
    "tags": [
      "type:service",
      "scope:designs"
    ]
  },
  "dependencies": {
    "@atelier/contracts-ts": "workspace:*",
    "@atelier/kernel": "workspace:*",
    "@atelier/service-kit": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
