{
  "name": "@atelier/drape",
  "version": "0.9.0",
  "private": true,
  "description": "Moteur drape : simulation XPBD du tombé d'un tissu sur un corps, sur CPU, sans dépendance.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start": "node dist/main.js"
  },
  "nx": {
    "tags": [
      "type:engine"
    ]
  },
  "dependencies": {
    "@atelier/contracts-ts": "workspace:*",
    "@atelier/mannequin": "workspace:*",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  }
}
