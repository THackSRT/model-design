{
  "name": "@atelier/drafting",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur drafting : tracé 2D des patrons par FreeSewing (ADR 0019), fiches de couture et contrôles ; cœur pur et déterministe, identique dans le navigateur, un Worker et Node ; adaptateur : @freesewing/*.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./geometry": {
      "source": "./src/geometry.ts",
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    }
  },
  "files": [
    "dist",
    "NOTICE-FREESEWING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "nx": {
    "tags": [
      "type:engine"
    ]
  },
  "dependencies": {
    "@atelier/contracts-ts": "workspace:*",
    "@freesewing/brian": "4.10.2",
    "@freesewing/core": "4.10.2",
    "@freesewing/models": "4.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  }
}
