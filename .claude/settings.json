{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check:affected)",
      "Bash(pnpm contracts:gen)",
      "Bash(pnpm contracts:check)",
      "Bash(pnpm format:check)",
      "Bash(pnpm docs:build)",
      "Bash(pnpm gen:*)",
      "Bash(pnpm nx run:*)",
      "Bash(pnpm nx show:*)",
      "Bash(pnpm nx affected:*)",
      "Bash(npx prettier:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run lint-imports:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose -f platform/docker-compose.yml ps:*)",
      "Bash(docker compose -f platform/docker-compose.yml logs:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Edit(prototype/**)",
      "Write(prototype/**)",
      "Edit(**/generated/**)",
      "Write(**/generated/**)",
      "Edit(engines/*/tests/golden/**)",
      "Write(engines/*/tests/golden/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  }
}
