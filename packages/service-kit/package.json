{
  "name": "@atelier/service-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Socle des microservices : journaux, configuration, validation par contrat, erreurs RFC 9457, client HTTP, événements CloudEvents.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "source": "./src/nest/index.ts",
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "nx": {
    "tags": [
      "type:service-kit"
    ]
  },
  "dependencies": {
    "@atelier/contracts-ts": "workspace:*",
    "@atelier/kernel": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  }
}
