{
  "name": "@atelier/contracts-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Types et schémas générés depuis contracts/ (pnpm contracts:gen). Ne pas modifier src/generated à la main.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "nx": {
    "tags": [
      "type:contracts"
    ]
  }
}
