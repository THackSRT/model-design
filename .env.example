# Copier en .env à la racine du service concerné. Aucune valeur réelle ici : les secrets vivent dans
# le gestionnaire de secrets de la plateforme.

# services/designs
PORT=3101
# Sans DATABASE_URL, le service garde ses données en mémoire (développement uniquement).
# Le service se connecte avec le rôle sans privilège ; les migrations passent par le propriétaire des tables.
DATABASE_URL=postgres://designs_app:designs-app-dev@localhost:5432/designs
MIGRATION_DATABASE_URL=postgres://atelier:atelier-dev@localhost:5432/designs
MIGRATE_ON_START=true
PATTERNING_URL=http://localhost:3201
PATTERNING_TIMEOUT_MS=2000
# Relais de l'outbox vers NATS JetStream (flux DESIGNS) ; sans NATS_URL, pas de relais.
# NATS_URL=nats://localhost:4222
# OUTBOX_INTERVAL_MS=1000
# OUTBOX_BATCH_SIZE=100
